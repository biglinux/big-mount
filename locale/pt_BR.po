#: big-mount/usr/bin/bigmount:84
msgid "bigmount: mounting the internal partitions needs administrator rights. big-mount.service does it at every boot."
msgstr "bigmount: montar as partições internas exige direitos de administrador. O big-mount.service faz isso a cada inicialização."

#: big-mount/usr/bin/bigmount:85
msgid "To mount them now:            sudo systemctl restart big-mount"
msgstr "Para montá-las agora:          sudo systemctl restart big-mount"

#: big-mount/usr/bin/bigmount:86
msgid "To see what would be mounted: bigmount --dry-run"
msgstr "Para ver o que seria montado:  bigmount --dry-run"

#: big-mount/usr/bin/bigmount:87
msgid "To check the installation:    bigmount --doctor"
msgstr "Para verificar a instalação:   bigmount --doctor"

#: big-mount/usr/bin/bigmount:97
msgid "cannot open the lock file /run/lock/big-mount.lock, giving up"
msgstr "não foi possível abrir o arquivo de trava /run/lock/big-mount.lock, desistindo"

#: big-mount/usr/bin/bigmount:102
msgid "another bigmount is still running, giving up"
msgstr "outro bigmount ainda está em execução, desistindo"

#: big-mount/usr/bin/bigmount:144
msgid "last login '%s' is not a known account, ignoring it"
msgstr "o último login '%s' não é uma conta conhecida; ignorando"

#: big-mount/usr/bin/bigmount:165
msgid "/etc/big-mount.conf: unknown value '%s', using shared"
msgstr "/etc/big-mount.conf: valor desconhecido '%s', usando shared"

#: big-mount/usr/bin/bigmount:284
msgid "%s: skipped, %s is not a filesystem"
msgstr "%s: ignorado, %s não é um sistema de arquivos"

#: big-mount/usr/bin/bigmount:290
msgid "%s: skipped, virtual device"
msgstr "%s: ignorado, dispositivo virtual"

#: big-mount/usr/bin/bigmount:297
msgid "%s: skipped, already mounted"
msgstr "%s: ignorado, já está montado"

#: big-mount/usr/bin/bigmount:333
msgid "waiting for udev to finish processing %s"
msgstr "aguardando o udev terminar de processar %s"

#: big-mount/usr/bin/bigmount:383
msgid "%s: udev has no information about it yet, not mounting"
msgstr "%s: o udev ainda não tem informações sobre ele, não será montado"

#: big-mount/usr/bin/bigmount:387
msgid "%s: skipped, hidden by udev/UDisks (UDISKS_IGNORE)"
msgstr "%s: ignorado, oculto pelo udev/UDisks (UDISKS_IGNORE)"

#: big-mount/usr/bin/bigmount:395
msgid "%s: left to UDisks, external device (%s)"
msgstr "%s: deixado para o UDisks, dispositivo externo (%s)"

#: big-mount/usr/bin/bigmount:401
msgid "%s: skipped, listed in /etc/fstab"
msgstr "%s: ignorado, listado no /etc/fstab"

#: big-mount/usr/bin/bigmount:453
msgid "%s: device changed during the scan, not mounting"
msgstr "%s: o dispositivo mudou durante a varredura, não será montado"

#: big-mount/usr/bin/bigmount:479
msgid "%s: NTFS refused read-write mount (%s), retrying read-only"
msgstr "%s: o NTFS recusou a montagem com gravação (%s), tentando somente leitura"

#: big-mount/usr/bin/bigmount:496
msgid "%s: mount of %s on %s failed (exit %s)"
msgstr "%s: a montagem de %s em %s falhou (código %s)"

#: big-mount/usr/bin/bigmount:517
msgid "%s: the driver mounted %s read-only on its own (%s)"
msgstr "%s: o driver montou %s somente para leitura por conta própria (%s)"

#: big-mount/usr/bin/bigmount:524
msgid "%s: would be mounted %s on %s (%s)"
msgstr "%s: seria montado como %s em %s (%s)"

#: big-mount/usr/bin/bigmount:526
msgid "%s: mounted %s on %s (%s)"
msgstr "%s: %s montado em %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:28
msgid "Usage: bigmount [OPTION]"
msgstr "Uso: bigmount [OPÇÃO]"

#: big-mount/usr/lib/big-mount/cli.sh:31
msgid "(none)"
msgstr "(nenhuma)"

#: big-mount/usr/lib/big-mount/cli.sh:31
msgid "mount internal partitions (run at boot by big-mount.service)"
msgstr "monta as partições internas (executado no boot pelo big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:32
msgid "show what would be mounted, change nothing"
msgstr "mostra o que seria montado, sem alterar nada"

#: big-mount/usr/lib/big-mount/cli.sh:33
msgid "check the boot service and what it did in this boot"
msgstr "verifica o serviço de inicialização e o que ele fez nesta inicialização"

#: big-mount/usr/lib/big-mount/cli.sh:34
msgid "show the version and the source revision"
msgstr "mostra a versão e a revisão do código-fonte"

#: big-mount/usr/lib/big-mount/cli.sh:35
msgid "show this help"
msgstr "mostra esta ajuda"

#: big-mount/usr/lib/big-mount/cli.sh:36
msgid "Configuration: /etc/big-mount.conf. To mount again now: sudo systemctl restart big-mount"
msgstr "Configuração: /etc/big-mount.conf. Para montar de novo agora: sudo systemctl restart big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:37
msgid "Diagnosis of devices, safe removal and file rescue: big-storage-rescue (package big-storage-rescue)."
msgstr "Diagnóstico de dispositivos, remoção segura e resgate de arquivos: big-storage-rescue (pacote big-storage-rescue)."

#: big-mount/usr/lib/big-mount/cli.sh:55 big-mount/usr/lib/big-mount/cli.sh:255
msgid "bigmount: unknown option '%s' (see bigmount --help)"
msgstr "bigmount: opção desconhecida '%s' (veja bigmount --help)"

#: big-mount/usr/lib/big-mount/cli.sh:71
msgid "bigmount: Secure Erase is no longer part of Big-Mount."
msgstr "bigmount: o Secure Erase não faz mais parte do Big-Mount."

#: big-mount/usr/lib/big-mount/cli.sh:77
msgid "bigmount: %s moved to Big Storage Rescue. Use: %s"
msgstr "bigmount: %s foi para o Big Storage Rescue. Use: %s"

#: big-mount/usr/lib/big-mount/cli.sh:79
msgid "Install it with: sudo pacman -S big-storage-rescue"
msgstr "Instale-o com: sudo pacman -S big-storage-rescue"

#: big-mount/usr/lib/big-mount/cli.sh:114
msgid "source checkout (not installed by a package)"
msgstr "cópia do código-fonte (não instalada por um pacote)"

#: big-mount/usr/lib/big-mount/cli.sh:123
msgid "package:"
msgstr "pacote:"

#: big-mount/usr/lib/big-mount/cli.sh:123
msgid "revision:"
msgstr "revisão:"

#: big-mount/usr/lib/big-mount/cli.sh:123
msgid "source:"
msgstr "origem:"

#: big-mount/usr/lib/big-mount/cli.sh:131
msgid "unknown"
msgstr "desconhecido"

#: big-mount/usr/lib/big-mount/cli.sh:174
msgid "Missing file of the package: %s"
msgstr "Arquivo do pacote ausente: %s"

#: big-mount/usr/lib/big-mount/cli.sh:175 big-mount/usr/lib/big-mount/cli.sh:184 big-mount/usr/lib/big-mount/cli.sh:206
msgid "Reinstall the big-mount package."
msgstr "Reinstale o pacote big-mount."

#: big-mount/usr/lib/big-mount/cli.sh:183
msgid "Unsafe owner or permissions: %s (%s)"
msgstr "Dono ou permissões inseguros: %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:191
msgid "Boot service (big-mount.service)"
msgstr "Serviço de inicialização (big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:193
msgid "/etc/bigmountall-no exists: mounting at boot is disabled on purpose"
msgstr "/etc/bigmountall-no existe: a montagem na inicialização está desativada de propósito"

#: big-mount/usr/lib/big-mount/cli.sh:205
msgid "Enabled at boot"
msgstr "Ativado na inicialização"

#: big-mount/usr/lib/big-mount/cli.sh:206
msgid "Not found by systemd"
msgstr "Não encontrado pelo systemd"

#: big-mount/usr/lib/big-mount/cli.sh:207
msgid "Not enabled at boot (%s)"
msgstr "Não ativado na inicialização (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:207
msgid "Enable it: sudo systemctl enable big-mount"
msgstr "Ative-o: sudo systemctl enable big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:210
msgid "Ran in this boot"
msgstr "Executado nesta inicialização"

#: big-mount/usr/lib/big-mount/cli.sh:212
msgid "State in this boot: %s (%s)"
msgstr "Estado nesta inicialização: %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:213
msgid "See: journalctl -b -u big-mount"
msgstr "Veja: journalctl -b -u big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:216
msgid "The unit is replaced by %s"
msgstr "A unidade é substituída por %s"

#: big-mount/usr/lib/big-mount/cli.sh:217
msgid "A copy in /etc/systemd/system overrides the package: remove it unless it is intended."
msgstr "Uma cópia em /etc/systemd/system substitui a do pacote: remova-a, a menos que seja intencional."

#: big-mount/usr/lib/big-mount/cli.sh:219
msgid "Drop-in files change the unit: %s"
msgstr "Arquivos drop-in alteram a unidade: %s"

#: big-mount/usr/lib/big-mount/cli.sh:229
msgid "Partitions handled by Big-Mount at boot: %d"
msgstr "Partições tratadas pelo Big-Mount na inicialização: %d"

#: big-mount/usr/lib/big-mount/cli.sh:230
msgid "Failed at boot"
msgstr "Falharam na inicialização"

#: big-mount/usr/lib/big-mount/cli.sh:231
msgid "Mounted read-only at boot"
msgstr "Montadas somente leitura na inicialização"

#: big-mount/usr/lib/big-mount/cli.sh:237
msgid "Configuration: PERMISSIONS=%s"
msgstr "Configuração: PERMISSIONS=%s"

#: big-mount/usr/lib/big-mount/cli.sh:238
msgid "Configuration: unknown PERMISSIONS value, shared is used"
msgstr "Configuração: valor de PERMISSIONS desconhecido, shared é usado"

#: big-mount/usr/lib/big-mount/cli.sh:246
msgid "Warnings in the journal of this boot"
msgstr "Avisos no journal desta inicialização"

#: big-mount/usr/lib/big-mount/cli.sh:249
msgid "The journal is not readable by this user: boot messages not checked"
msgstr "O journal não pode ser lido por este usuário: mensagens da inicialização não verificadas"

#: big-mount/usr/lib/big-mount/cli.sh:260
msgid "Big-Mount check (nothing is changed; labels and mount points are left out)"
msgstr "Verificação do Big-Mount (nada é alterado; rótulos e pontos de montagem ficam de fora)"

#: big-mount/usr/lib/big-mount/cli.sh:264
msgid "Result: %d problem(s), %d warning(s)."
msgstr "Resultado: %d problema(s), %d aviso(s)."

#: big-mount/usr/lib/big-mount/cli.sh:266
msgid "Why a partition is read-only or failed to mount, and the health of its drive: big-storage-rescue --diagnose DEVICE"
msgstr "Por que uma partição está somente leitura ou não foi montada, e a saúde da unidade dela: big-storage-rescue --diagnose DISPOSITIVO"

#: big-mount/usr/lib/big-mount/cli.sh:268
msgid "To find out why a partition is read-only or failed to mount, install big-storage-rescue."
msgstr "Para saber por que uma partição está somente leitura ou não foi montada, instale o big-storage-rescue."
