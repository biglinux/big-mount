#: big-mount/usr/bin/bigmount:84
msgid "bigmount: mounting the internal partitions needs administrator rights. big-mount.service does it at every boot."
msgstr "bigmount: voor het aankoppelen van de interne partities zijn beheerdersrechten nodig. big-mount.service doet dit bij elke systeemstart."

#: big-mount/usr/bin/bigmount:85
msgid "To mount them now:            sudo systemctl restart big-mount"
msgstr "Nu aankoppelen:                          sudo systemctl restart big-mount"

#: big-mount/usr/bin/bigmount:86
msgid "To see what would be mounted: bigmount --dry-run"
msgstr "Bekijken wat er aangekoppeld zou worden: bigmount --dry-run"

#: big-mount/usr/bin/bigmount:87
msgid "To check the installation:    bigmount --doctor"
msgstr "De installatie controleren:              bigmount --doctor"

#: big-mount/usr/bin/bigmount:97
msgid "cannot open the lock file /run/lock/big-mount.lock, giving up"
msgstr "kan het vergrendelingsbestand /run/lock/big-mount.lock niet openen, gestopt"

#: big-mount/usr/bin/bigmount:102
msgid "another bigmount is still running, giving up"
msgstr "er draait nog een andere bigmount, gestopt"

#: big-mount/usr/bin/bigmount:144
msgid "last login '%s' is not a known account, ignoring it"
msgstr "laatste aanmelding '%s' is geen bekend account, wordt genegeerd"

#: big-mount/usr/bin/bigmount:165
msgid "/etc/big-mount.conf: unknown value '%s', using shared"
msgstr "/etc/big-mount.conf: onbekende waarde '%s', shared wordt gebruikt"

#: big-mount/usr/bin/bigmount:284
msgid "%s: skipped, %s is not a filesystem"
msgstr "%s: overgeslagen, %s is geen bestandssysteem"

#: big-mount/usr/bin/bigmount:290
msgid "%s: skipped, virtual device"
msgstr "%s: overgeslagen, virtueel apparaat"

#: big-mount/usr/bin/bigmount:297
msgid "%s: skipped, already mounted"
msgstr "%s: overgeslagen, al aangekoppeld"

#: big-mount/usr/bin/bigmount:333
msgid "waiting for udev to finish processing %s"
msgstr "wachten tot udev klaar is met het verwerken van %s"

#: big-mount/usr/bin/bigmount:383
msgid "%s: udev has no information about it yet, not mounting"
msgstr "%s: udev heeft er nog geen informatie over, wordt niet aangekoppeld"

#: big-mount/usr/bin/bigmount:387
msgid "%s: skipped, hidden by udev/UDisks (UDISKS_IGNORE)"
msgstr "%s: overgeslagen, verborgen door udev/UDisks (UDISKS_IGNORE)"

#: big-mount/usr/bin/bigmount:395
msgid "%s: left to UDisks, external device (%s)"
msgstr "%s: overgelaten aan UDisks, extern apparaat (%s)"

#: big-mount/usr/bin/bigmount:401
msgid "%s: skipped, listed in /etc/fstab"
msgstr "%s: overgeslagen, staat in /etc/fstab"

#: big-mount/usr/bin/bigmount:453
msgid "%s: device changed during the scan, not mounting"
msgstr "%s: apparaat is tijdens het scannen gewijzigd, wordt niet aangekoppeld"

#: big-mount/usr/bin/bigmount:479
msgid "%s: NTFS refused read-write mount (%s), retrying read-only"
msgstr "%s: NTFS weigerde aankoppelen met schrijftoegang (%s), opnieuw proberen als alleen-lezen"

#: big-mount/usr/bin/bigmount:496
msgid "%s: mount of %s on %s failed (exit %s)"
msgstr "%s: aankoppelen van %s op %s mislukt (afsluitcode %s)"

#: big-mount/usr/bin/bigmount:517
msgid "%s: the driver mounted %s read-only on its own (%s)"
msgstr "%s: het stuurprogramma heeft %s uit zichzelf als alleen-lezen aangekoppeld (%s)"

#: big-mount/usr/bin/bigmount:524
msgid "%s: would be mounted %s on %s (%s)"
msgstr "%s: zou %s worden aangekoppeld op %s (%s)"

#: big-mount/usr/bin/bigmount:526
msgid "%s: mounted %s on %s (%s)"
msgstr "%s: %s aangekoppeld op %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:28
msgid "Usage: bigmount [OPTION]"
msgstr "Gebruik: bigmount [OPTIE]"

#: big-mount/usr/lib/big-mount/cli.sh:31
msgid "(none)"
msgstr "(geen)"

#: big-mount/usr/lib/big-mount/cli.sh:31
msgid "mount internal partitions (run at boot by big-mount.service)"
msgstr "interne partities aankoppelen (bij het opstarten uitgevoerd door big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:33
msgid "show what would be mounted, change nothing"
msgstr "tonen wat er aangekoppeld zou worden, niets wijzigen"

#: big-mount/usr/lib/big-mount/cli.sh:34
msgid "check the boot service and what it did in this boot"
msgstr "de opstartdienst controleren en wat die tijdens deze opstart heeft gedaan"

#: big-mount/usr/lib/big-mount/cli.sh:35
msgid "show the version and the source revision"
msgstr "de versie en de broncoderevisie tonen"

#: big-mount/usr/lib/big-mount/cli.sh:36
msgid "show this help"
msgstr "deze hulp tonen"

#: big-mount/usr/lib/big-mount/cli.sh:37
msgid "Configuration: /etc/big-mount.conf. To mount again now: sudo systemctl restart big-mount"
msgstr "Configuratie: /etc/big-mount.conf. Nu opnieuw aankoppelen: sudo systemctl restart big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:38
msgid "Diagnosis of devices, safe removal and file rescue: big-storage-rescue (package big-storage-rescue)."
msgstr "Diagnose van apparaten, veilig verwijderen en bestanden redden: big-storage-rescue (pakket big-storage-rescue)."

#: big-mount/usr/lib/big-mount/cli.sh:56 big-mount/usr/lib/big-mount/cli.sh:268
msgid "bigmount: unknown option '%s' (see bigmount --help)"
msgstr "bigmount: onbekende optie '%s' (zie bigmount --help)"

#: big-mount/usr/lib/big-mount/cli.sh:72
msgid "bigmount: Secure Erase is no longer part of Big-Mount."
msgstr "bigmount: Secure Erase maakt geen deel meer uit van Big-Mount."

#: big-mount/usr/lib/big-mount/cli.sh:78
msgid "bigmount: %s moved to Big Storage Rescue. Use: %s"
msgstr "bigmount: %s is verhuisd naar Big Storage Rescue. Gebruik: %s"

#: big-mount/usr/lib/big-mount/cli.sh:80
msgid "Install it with: sudo pacman -S big-storage-rescue"
msgstr "Installeer het met: sudo pacman -S big-storage-rescue"

#: big-mount/usr/lib/big-mount/cli.sh:127
msgid "source checkout (not installed by a package)"
msgstr "broncode-checkout (niet door een pakket geïnstalleerd)"

#: big-mount/usr/lib/big-mount/cli.sh:136
msgid "package:"
msgstr "pakket:"

#: big-mount/usr/lib/big-mount/cli.sh:136
msgid "revision:"
msgstr "revisie:"

#: big-mount/usr/lib/big-mount/cli.sh:136
msgid "source:"
msgstr "bron:"

#: big-mount/usr/lib/big-mount/cli.sh:144
msgid "unknown"
msgstr "onbekend"

#: big-mount/usr/lib/big-mount/cli.sh:187
msgid "Missing file of the package: %s"
msgstr "Ontbrekend bestand van het pakket: %s"

#: big-mount/usr/lib/big-mount/cli.sh:188
#: big-mount/usr/lib/big-mount/cli.sh:197
#: big-mount/usr/lib/big-mount/cli.sh:219
msgid "Reinstall the big-mount package."
msgstr "Installeer het pakket big-mount opnieuw."

#: big-mount/usr/lib/big-mount/cli.sh:196
msgid "Unsafe owner or permissions: %s (%s)"
msgstr "Onveilige eigenaar of rechten: %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:204
msgid "Boot service (big-mount.service)"
msgstr "Opstartdienst (big-mount.service)"

#: big-mount/usr/lib/big-mount/cli.sh:206
msgid "/etc/bigmountall-no exists: mounting at boot is disabled on purpose"
msgstr "/etc/bigmountall-no bestaat: aankoppelen bij het opstarten is bewust uitgeschakeld"

#: big-mount/usr/lib/big-mount/cli.sh:218
msgid "Enabled at boot"
msgstr "Ingeschakeld bij het opstarten"

#: big-mount/usr/lib/big-mount/cli.sh:219
msgid "Not found by systemd"
msgstr "Niet gevonden door systemd"

#: big-mount/usr/lib/big-mount/cli.sh:220
msgid "Not enabled at boot (%s)"
msgstr "Niet ingeschakeld bij het opstarten (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:220
msgid "Enable it: sudo systemctl enable big-mount"
msgstr "Schakel het in: sudo systemctl enable big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:223
msgid "Ran in this boot"
msgstr "Uitgevoerd tijdens deze opstart"

#: big-mount/usr/lib/big-mount/cli.sh:225
msgid "State in this boot: %s (%s)"
msgstr "Status tijdens deze opstart: %s (%s)"

#: big-mount/usr/lib/big-mount/cli.sh:226
msgid "See: journalctl -b -u big-mount"
msgstr "Zie: journalctl -b -u big-mount"

#: big-mount/usr/lib/big-mount/cli.sh:229
msgid "The unit is replaced by %s"
msgstr "De unit wordt vervangen door %s"

#: big-mount/usr/lib/big-mount/cli.sh:230
msgid "A copy in /etc/systemd/system overrides the package: remove it unless it is intended."
msgstr "Een kopie in /etc/systemd/system heeft voorrang op het pakket: verwijder die, tenzij het zo bedoeld is."

#: big-mount/usr/lib/big-mount/cli.sh:232
msgid "Drop-in files change the unit: %s"
msgstr "Drop-in-bestanden wijzigen de unit: %s"

#: big-mount/usr/lib/big-mount/cli.sh:242
msgid "Partitions handled by Big-Mount at boot: %d"
msgstr "Partities die Big-Mount bij het opstarten behandelt: %d"

#: big-mount/usr/lib/big-mount/cli.sh:243
msgid "Failed at boot"
msgstr "Mislukt bij het opstarten"

#: big-mount/usr/lib/big-mount/cli.sh:244
msgid "Mounted read-only at boot"
msgstr "Alleen-lezen aangekoppeld bij het opstarten"

#: big-mount/usr/lib/big-mount/cli.sh:250
msgid "Configuration: PERMISSIONS=%s"
msgstr "Configuratie: PERMISSIONS=%s"

#: big-mount/usr/lib/big-mount/cli.sh:251
msgid "Configuration: unknown PERMISSIONS value, shared is used"
msgstr "Configuratie: onbekende waarde voor PERMISSIONS, shared wordt gebruikt"

#: big-mount/usr/lib/big-mount/cli.sh:259
msgid "Warnings in the journal of this boot"
msgstr "Waarschuwingen in het journal van deze opstart"

#: big-mount/usr/lib/big-mount/cli.sh:262
msgid "The journal is not readable by this user: boot messages not checked"
msgstr "Het journal is niet leesbaar voor deze gebruiker: opstartberichten niet gecontroleerd"

#: big-mount/usr/lib/big-mount/cli.sh:273
msgid "Big-Mount check (nothing is changed; labels and mount points are left out)"
msgstr "Big-Mount-controle (er wordt niets gewijzigd; labels en aankoppelpunten worden weggelaten)"

#: big-mount/usr/lib/big-mount/cli.sh:277
msgid "Result: %d problem(s), %d warning(s)."
msgstr "Resultaat: problemen: %d, waarschuwingen: %d."

#: big-mount/usr/lib/big-mount/cli.sh:279
msgid "Why a partition is read-only or failed to mount, and the health of its drive: big-storage-rescue --diagnose DEVICE"
msgstr "Waarom een partitie alleen-lezen is of niet aangekoppeld kon worden, en de gezondheid van de schijf: big-storage-rescue --diagnose APPARAAT"

#: big-mount/usr/lib/big-mount/cli.sh:281
msgid "To find out why a partition is read-only or failed to mount, install big-storage-rescue."
msgstr "Installeer big-storage-rescue om te achterhalen waarom een partitie alleen-lezen is of niet aangekoppeld kon worden."
